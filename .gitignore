# =====================================================================
# .gitignore -- University Timetable Generation System
# Rule of thumb: commit code, SQL, Cypher, docs and .env.example;
# never commit secrets, local databases, virtual envs or generated junk.
# =====================================================================

# ---- Secrets and local configuration (NEVER commit) ------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets.toml
.streamlit/secrets.toml
credentials.json

# ---- Python -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
MANIFEST
pip-wheel-metadata/
pip-log.txt
pip-delete-this-directory.txt

# ---- Virtual environments (venv, uv, poetry, pipenv, conda) -----------
.venv/
venv/
env/
ENV/
.python-version
.uv/
uv.lock.bak
.pipenv/
.conda/
.direnv/

# ---- Test, coverage and tooling caches ---------------------------------
.pytest_cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
nosetests.xml
*.cover

# ---- Jupyter / notebooks ------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---- Streamlit -----------------------------------------------------------
.streamlit/cache/
.streamlit/*.log

# ---- Docker volumes and local database data -------------------------------
# docker-compose bind mounts / data folders (named volumes live outside the repo)
mysql_data/
mysql-data/
neo4j_data/
neo4j-data/
neo4j/data/
neo4j/logs/
neo4j/plugins/
neo4j/import/
data/
volumes/
docker-compose.override.yml

# Raw database files if someone points a server at the project folder
*.ibd
*.frm
*.MYD
*.MYI
ibdata1
ib_logfile*
*.db
*.sqlite
*.sqlite3

# ---- Logs, dumps and generated output --------------------------------------
*.log
logs/
*.out
*.pid
*.dump
*.bak
*.backup
# full database dumps (keep the hand-written sql/*.sql files)
dump*.sql
backup*.sql
*_dump.sql
exports/
output/
reports/
*.csv.tmp

# ---- Editors and IDEs --------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~
.#*
\#*#
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
.fleet/
.history/

# ---- Operating-system files ----------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
.Trash-*
.fuse_hidden*
.nfs*

# ---- Archives and downloads (the project zip you exchange) ----------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ---- Claude Code local state (CLAUDE.md itself is meant to be shared) -------------
.claude/settings.local.json
.claude/cache/